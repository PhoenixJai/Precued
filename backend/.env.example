# Postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/precued
DATABASE_USER=precued
DATABASE_PASSWORD=precued

# LiveKit Cloud — get from LiveKit Cloud project settings. Use the wss://
# form exactly as shown on the dashboard — the backend derives the
# https:// REST API URL from this itself (same host, LiveKit serves both
# on it); do not set a second host for the server SDK.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=wss://your-project.livekit.cloud

# Magic-link auth email (SMTP) — using Resend's SMTP relay. SMTP_USER is
# literally the string "resend"; SMTP_PASSWORD is your Resend API key.
# MAIL_FROM_ADDRESS defaults to onboarding@resend.dev, which only delivers to
# the Resend account owner's own address until a sending domain is verified.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=onboarding@resend.dev

APP_BASE_URL=http://localhost:5173
PORT=8080

# The frontend's origin (scheme + host, no trailing slash) — the frontend is
# deployed as a separate service/domain from this backend, so every browser
# request to /api/** is cross-origin and needs this to pass CORS. Leave
# blank for local dev (Vite's dev proxy makes requests same-origin already).
FRONTEND_ORIGIN=

# Cloudflare R2 (S3-compatible) — slide image storage for the Presentations
# feature (Chunk 2). Endpoint is derived server-side as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com — do not set a separate
# endpoint var. Create an R2 API token with Object Read & Write scoped to
# one bucket (Cloudflare dashboard -> R2 -> Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
