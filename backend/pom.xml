<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.precued</groupId>
    <artifactId>precued-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>precued-backend</name>
    <description>Role-based visibility control engine for video calls</description>

    <properties>
        <java.version>21</java.version>
        <livekit-server.version>0.9.1</livekit-server.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <aws-sdk.version>2.54.13</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation for DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA / Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Postgres driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway for migrations (matches db/migration folder) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Mail for magic-link auth -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- M-Auth: session enforcement on write endpoints (Precued_Issues_Update_3.md).
             Replaces ad hoc 401 handling in the interceptors with the standard
             framework's filter chain + authorizeHttpRequests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- LiveKit server SDK: REST + JWT + webhook signature verification.
             Not as first-class as Node/Go/Python but the surface is plain
             HTTP — see docs/ADR-001-stack.md for the accepted trade-off. -->
        <dependency>
            <groupId>io.livekit</groupId>
            <artifactId>livekit-server</artifactId>
            <version>${livekit-server.version}</version>
        </dependency>

        <!-- Chunk 2 (Presentations feature, PDF import pipeline): renders each
             PDF page to an image. 3.0.8 — current stable; the only CVE against
             the 2.0.24-3.0.7 range (CVE-2026-23907, path traversal) is in the
             pdfbox-examples module, which we don't depend on. Older XXE
             (CVE-2019-0228) and DoS (CVE-2021-31811/31812) issues are long
             fixed by this version. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Chunk 2: S3-compatible client used against Cloudflare R2 (different
             endpoint, same API) for slide image storage. Excludes the default
             apache5-client: at BOM 2.54.13 it requires httpclient5 5.4+'s
             TlsSocketStrategy, but something elsewhere in this project's
             dependency tree pins httpclient5 to 5.3.1, which throws
             NoClassDefFoundError at S3Client construction (confirmed via
             StorageConfigTest, not assumed) — verified this way instead of
             chasing the version-pinning source, since our usage (one
             synchronous upload/download per request, no connection-pool
             tuning) doesn't need Apache's client anyway. url-connection-client
             is the simplest sync HTTP client with no such conflict. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- Lombok to cut entity/DTO boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- In-memory DB for JPA integration tests that need real Hibernate
             lazy-loading/session behavior (Mockito mocks can't reproduce
             LazyInitializationException) — production still runs on
             Postgres, this is test-only, schema built from @Entity mappings
             (see LiveKitTokenIntegrationTest and its application-integrationtest.yml). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
